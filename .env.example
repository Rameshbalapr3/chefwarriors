# Desktop sync + Vercel cloud POS (server-only secrets — never commit real values)
POS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
POS_SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
POS_SUPABASE_SHOP_ID=default
POS_SESSION_SECRET=replace-with-a-long-random-string

# Set only on the Vercel web build (not needed for local desktop)
VITE_POS_CLOUD=true
