{
  "name": "chefwarriors-pos",
  "version": "1.2.0",
  "description": "Offline restaurant billing and paired printer queue",
  "author": "Chef Warriors",
  "private": true,
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && npm run build:desktop",
    "build:desktop": "esbuild desktop/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-desktop/main.cjs && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-desktop/preload.cjs",
    "desktop": "electron .",
    "package": "npm run build && electron-builder --win nsis --x64",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.25.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "com.chefwarriors.pos",
    "productName": "Chef Warriors POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
